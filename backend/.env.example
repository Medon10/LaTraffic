PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/latraffic

# Clave secreta para firma y verificación de JWT (OBLIGATORIO: mínimo 32 caracteres)
TOKEN_SECRET=cambiar_en_produccion_por_un_secreto_seguro_minimo_32_caracteres
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=true

# ── Google Maps (T-08, RF-16) ────────────────────────────────────────────────
# API Key con la Directions API habilitada en Google Cloud Console.
# Sin esta variable el endpoint GET /chofer/viajes/:id/ruta devuelve HTTP 503.
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ── Mercado Pago ─────────────────────────────────────────────────────────────
MP_ACCESS_TOKEN=your_mercadopago_access_token_here
MP_WEBHOOK_SECRET=your_mercadopago_webhook_secret_here

# ── Transferencia bancaria (HU-09) ───────────────────────────────────────────
TRANSFERENCIA_ALIAS=LATRAFFIC.COLON
TRANSFERENCIA_CBU=0000003100010000000001
TRANSFERENCIA_TITULAR=LaTraffic
TRANSFERENCIA_BANCO=Banco de la Nación Argentina
ADMIN_WHATSAPP_PHONE=5493482000000

