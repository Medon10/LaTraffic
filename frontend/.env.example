# ── URL del backend ────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000

# ── Google Maps JavaScript API + Places API (T-14) ────────────────────────────
# API Key SEPARADA de la del backend (GOOGLE_MAPS_API_KEY en backend/.env).
# Esta key debe estar restringida por HTTP referrer a tu dominio de producción
# (NO por IP, esa restricción es para la key del backend).
#
# APIs que deben estar habilitadas para esta key en Google Cloud Console:
#   - Maps JavaScript API
#   - Places API
#
# Restricción de HTTP referrer recomendada:
#   - http://localhost:5173/*    (desarrollo local)
#   - https://tudominio.com/*   (producción)
#
# Sin esta variable el componente MapaPicker cae gracefully al input de texto
# libre (sin mapa ni autocompletado), por lo que la app sigue siendo funcional.
VITE_GOOGLE_MAPS_API_KEY=your_maps_js_api_key_here
